# Copiar como .env SOLO para instalacion manual/Atlas; .env esta ignorado por Git.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gymflow
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60
APP_ENV=local
# Docker Compose usa automaticamente mongo:27017 y redis:6379 si no hay .env.
# Para Atlas: configurar MONGODB_URI y permitir IP del contenedor/servidor.

# Invitaciones por correo: desarrollo usa Mailpit, NO entrega mensajes externamente.
# Docker Compose usa valores por defecto; para Virtualmin configurar SMTP seguro y APP_URL.
APP_URL=http://localhost:8000/
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_ENCRYPTION=none
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@gymflow.test
MAIL_FROM_NAME=GymFlow